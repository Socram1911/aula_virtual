{
    "name": "aula-virtual/aula-virtual",
    "description": "Aula Virtual Académica - plataforma institucional de aula virtual (MVC modular PHP)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "aws/aws-sdk-php": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Shared/helpers.php"
        ]
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php",
        "test": "php tests/run.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
