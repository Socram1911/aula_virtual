# ===== Aplicación =====
APP_NAME="Aula Virtual Académica"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/aula_virtual/public

# ===== Base de datos (PDO) =====
# Driver: "mysql" (desarrollo local) o "pgsql" (producción, p. ej. Neon).
#
# --- Desarrollo local (MySQL/MariaDB) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aula_virtual
DB_USER=root
DB_PASS=

# --- Producción con Neon (PostgreSQL) ---
# 1) Crea un proyecto en https://neon.tech y copia la "connection string" (empieza con postgresql://).
# 2) Usa SIEMPRE la "Direct connection" (sin el sufijo "-pooler"). La conexión
#    "pooled" (PgBouncer) no soporta bien sentencias preparadas nativas dentro de
#    transacciones y provoca errores "current transaction is aborted".
# 3) Desglósala así:
#    DB_DRIVER=pgsql
#    DB_HOST=ep-xxx.region.aws.neon.tech
#    DB_PORT=5432
#    DB_NAME=neondb
#    DB_USER=neondb_owner
#    DB_PASS=xxxxxxxx
#    DB_SSLMODE=require
#
# Opcional: para clientes con libpq antiguo sin soporte SNI (p. ej. XAMPP en
# Windows), se envía el "endpoint id" de Neon (la primera parte del host).
# Normalmente se deduce automáticamente del DB_HOST; solo defínelo si falla:
#    DB_ENDPOINT_ID=ep-xxx

# ===== Almacenamiento de archivos (Cloudflare R2, S3-compatible) =====
# Los archivos subidos y los paquetes H5P se guardan como objetos en R2.
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=aula-virtual

# ===== Sesión =====
# Las sesiones se guardan en la base de datos (tabla `sessions`) para que
# sobrevivan a reinicios y "cold starts" en entornos de disco efímero.
SESSION_NAME=aula_virtual_session

# ===== Zona horaria =====
# Debe coincidir con la base de datos para comparar fechas correctamente (UTC recomendado).
APP_TIMEZONE=UTC

# ===== Correo transaccional (Resend) =====
# Clave de API de https://resend.com/api-keys (empieza con re_).
# Si se deja vacía, los correos de aprobación NO se enviarán (el flujo sigue funcionando).
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Aula Virtual <no-reply@tu-dominio.com>".
RESEND_FROM="Aula Virtual <no-reply@tu-dominio.com>"
